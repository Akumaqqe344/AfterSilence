extends RefCounted
const NAMES = {"vera":["Вера","Vera"],"nadia":["Надя · врач","Nadia · physician"],"lev":["Лев · механик","Lev · mechanic"],"mara":["Мара · архивариус","Mara · archivist"],"pavel":["Павел · староста","Pavel · mayor"],"sonya":["Соня · свидетель","Sonya · witness"]}
const CLUES = {
 "photo":["Фотография у колодца","Photograph by the well","На снимке вы с Алиной стоите перед библиотекой. Подпись на обороте: «Если я снова забуду — расскажи, почему мы не закрыли дверь». У тебя нет воспоминания об этом дне. Врач Надя знает Алину, но при имени сестры смотрит на воду. На краю снимка видна рука ребёнка.","You and Alina stand outside the library. On the back: ‘If I forget again, tell me why we left the door open.’ You cannot remember that day. Nadia knows Alina, but looks at the water when you mention your sister. A child's hand appears at the edge."],
 "poster":["Афиша ночного собрания","Night meeting poster","Дождь. Колокол. Тишина. Так дети запоминали порядок действий при наводнении. На афише написано: «Собрание началось в 02:17». Но по официальной версии в ту ночь никто не выходил из дома. Под афишей свежий клей, а бумага пожелтела десять лет назад.","Rain. Bell. Silence. The children learned this order for flood drills. The poster says the meeting began at 02:17. The official account says nobody left home that night. The glue is fresh, but the paper is ten years old."],
 "ledger":["Переписанный список","Rewritten register","В графе «эвакуированные» двадцать три имени. В графе «погибшие» — прочерк. Под верхним листом отпечатался старый список: двадцать четыре имени, последнее — Алина. Удалённая строка не означает смерть. Кто-то изменил статус человека, чтобы спрятать маршрут остальных.","Twenty-three evacuees; no recorded deaths. Underneath is an imprint of an older list: twenty-four names, the last one Alina. A removed entry does not prove a death. Someone altered a person's status to conceal the route taken by the others."],
 "clock":["Часы, остановленные вручную","Clock stopped by hand","За циферблатом стоит предохранитель, а не сломанная шестерня. Часы остановили в момент отключения сигнала. На корпусе три риски: час, десятки минут, минуты. Момент события можно восстановить по афише, если связать эти два свидетельства в журнале.","Behind the dial is a fuse, not a broken gear. The clock stopped when the signal was cut. Three marks indicate the hour, tens of minutes and minutes. The poster can restore the time once both pieces of evidence are connected in the journal."],
 "diagram":["Схема аварийного реле","Emergency relay diagram","Первый и третий контуры питают насос. Средний включает колокол, который приведёт к укрытию всё, что слышит город. Для тихого запуска нужны включённые первый и третий рычаги и выключенный средний. Предохранитель можно взять у Льва. Тот же предмет подходит к свету библиотеки, откуда его можно извлечь обратно.","The first and third circuits power the pump. The middle circuit rings a bell that will draw anything listening toward the shelter. For a quiet start, switch the first and third levers on and the middle one off. Lev has a fuse. It also fits the library light and can be removed again."],
 "testimony":["Рассказ Сони","Sonya's testimony","«Алина не заперла нас внизу. Она открыла служебный проход. Когда насос остановился, вода пошла в сторону площади. Павел приказал выключить колокол: он боялся, что остальные побегут туда же. Алина осталась у ручного затвора. Я её не видела после рассвета. Это всё, что я знаю — не больше». Соня просит не выдавать её имя.","‘Alina did not lock us below. She opened the service passage. When the pump stopped, water headed toward the square. Pavel ordered the bell silenced, afraid everyone would follow us. Alina stayed at the manual sluice. I did not see her after dawn. That is all I know.’ Sonya asks you not to reveal her name."],
 "signature":["Подпись под приказом","Signature on the order","Чернила видны только в отголоске библиотеки. «Отключить сигнал. Изъять список. Наблюдение сохранить». Подпись Павла подлинная. Но за ней — карандашная приписка Мары: «Дети вышли через восточный проход». Их подписи стоят на одной бумаге по совершенно разным причинам.","The ink is visible only in the library's echo: ‘Cut the signal. Remove the list. Keep watch.’ Pavel's signature is genuine. Below it, Mara added in pencil: ‘The children escaped by the eastern passage.’ Their names share a page for very different reasons."],
 "medical":["Медицинская карточка · 06:40","Medical chart · 06:40","Ожоги ладоней. Следов долгого пребывания в воде нет. Ушла своим ходом в 06:40. Фамилия не вписана по просьбе пациентки; Надя узнала Алину. Сопоставьте время с часами: карточка доказывает, что после отключения сигнала она была жива, но не указывает, куда ушла.","Burned palms. No signs of prolonged immersion. Left unaided at 06:40. Surname omitted at the patient’s request; Nadia identified Alina. Compare the time with the clock: she survived the signal cut, but the chart does not establish where she went."]
}
const SCENES = {
 "intro":["Вера","Vera","Ты просыпаешься от звука капель, но за окном сухо. В кармане ключ от чужой двери и записка твоим почерком: «Не начинай с вопроса, кто виноват. Сначала спроси, кто ещё помнит». Город кажется знакомым. Ты знаешь путь к колодцу — и не можешь вспомнить собственный адрес. У воды стоит женщина в белом. Она произносит твоё имя раньше, чем ты успеваешь представиться.","You wake to dripping water, but the windows are dry. Your pocket holds a key to someone else's door and a note in your handwriting: ‘Do not start by asking who is guilty. Ask who still remembers.’ The town feels familiar. You know the way to the well, but cannot remember your address. A woman in white says your name before you introduce yourself."],
 "nadia_intro":["Надя","Nadia","Я обещала себе не говорить с тобой об Алине, пока ты сама не вспомнишь. Это было удобно: я могла называть молчание заботой. Твоя сестра исчезла после ночного собрания. Люди говорят, что она уехала. Я помню, как перевязывала ей руки утром, а потом не помню, чем закончился день. У нас не одна общая ложь. У каждого — своя причина держаться за неё. Найди фотографию у колодца и поговори с Марой в библиотеке. Только не обещай вернуть человека, которого ещё не нашла.","I promised not to mention Alina until you remembered her yourself. It was convenient to call silence kindness. Your sister vanished after the night meeting. People say she left. I remember dressing her hands that morning, but not how the day ended. We do not share a single lie: each of us has a different reason to keep quiet. Find the photograph by the well and speak to Mara at the library. Do not promise to bring back someone you have not found."],
 "nadia_again":["Надя","Nadia","Когда память возвращается, она не спрашивает, удобно ли нам сейчас. Если станет трудно — приходи к колодцу и отдохни. Отголосок забирает силы. Три перехода, потом нужен покой. Не оставайся там только потому, что боль кажется доказательством правды. Алина могла быть храброй и злиться. Ты можешь искать её и одновременно бояться того, что найдёшь.","Memory does not ask whether its return is convenient. Rest at the well if things become difficult. The echo drains you: three crossings, then rest. Do not stay just because pain feels like proof. Alina could be brave and angry. You can search for her and fear what you might discover."],
 "lev_intro":["Лев","Lev","Этот предохранитель сняли с насоса, а не с часов. Одинаковые гнёзда: люди до сих пор путают причины и последствия. Я чинил проводку и подписал акт исправности. Когда поднялась вода, я решил, что погибшие будут на моей совести. Поэтому поверил первому, кто сказал, что погибших нет. Впрочем, никто тогда не показал мне список. Возьми деталь. Её можно поставить в библиотечный свет или в лесное реле. Из светильника она вынимается обратно.","This fuse came from the pump, not the clock. Identical sockets: people still confuse cause and consequence. I signed off the wiring. When the water rose, I thought any deaths would be my fault. So I believed the first person who said nobody died. Nobody showed me the list. Take the part. It fits the library light or the forest relay. You can remove it from the light again."],
 "lev_again":["Лев","Lev","Не превращай найденную бумагу в ответ на все вопросы. Подпись означает, что человек сделал выбор, но не объясняет, какие варианты у него были. Мне хочется, чтобы Павел оказался единственным виновным. Тогда я снова смогу назвать себя просто механиком. Это желание — тоже часть того, что тебе нужно расследовать.","Do not turn one document into an answer to everything. A signature records a choice, not the alternatives available. I want Pavel to be the only guilty person, so I can be merely a mechanic again. That wish is part of what you must investigate."],
 "mara_intro":["Мара","Mara","Я переписала список. Да, я скажу это раньше, чем ты увидишь мою подпись. В первом списке были имена детей и адрес убежища. Во втором — только количество. Я хотела спрятать их от наблюдателя. Потом город научился прятать всё остальное. Каталог устроен как старая учебная считалка. Найди на площади афишу. Внутри часов осталась ещё одна часть того вечера. Сопоставляй свидетельства в журнале: сходство двух бумаг ещё не делает их связью.","I rewrote the list. I will say it before you find my signature. The first copy named the children and their shelter; the second kept only a number. I wanted to hide them from the observer. Then the town learned to hide everything else. The catalogue follows an old drill rhyme. Find the poster in the square. The clock holds another part of that evening. Connect evidence in the journal; resemblance alone is not a connection."],
 "mara_lens":["Мара","Mara","После открытия каталога зеркало перестало отражать эту комнату. Это не дверь в другое место — это след того же места, которое мы отказались помнить. Там может не оказаться привычного прохода. Проверь, куда ставишь ногу. Отголосок слышит бег и звон металла. Если найдёшь на бумаге чернила, которых здесь нет, не решай сразу, что именно этот вариант правдивее. Даже воспоминание умеет оправдываться.","Since the catalogue opened, the mirror no longer reflects this room. It is not another place, but a trace of the place we refused to remember. A familiar passage may be missing. Watch your step. The echo hears running and metal. If ink appears on a page there, do not assume that version is more truthful. Even a memory can make excuses."],
 "pavel_before":["Павел","Pavel","Каждый день кто-нибудь приносит мне своё вчера. Они не совпадают. Если я начну выбирать, чьё воспоминание правильное, город снова разделится на тех, кому поверили, и остальных. Поэтому я прошу дождаться доказательств. Удобная позиция для человека, чья подпись стоит на приказе? Да. Я понимаю, как это выглядит.","Every day somebody brings me their yesterday. None agree. If I choose whose memory is correct, the town will again divide into those believed and everyone else. So I ask for evidence. Convenient for the man who signed the order? Yes. I know how it looks."],
 "pavel_truth":["Павел","Pavel","Я выключил сигнал. У входа в убежище уже стояли люди; если бы площадь побежала вслед за детьми, проход не выдержал бы. Я выбрал тех, кого видел. Потом вычеркнул Алину: она вернулась к затвору, и я не знал, считать ли её спасённой. Мара спрятала детей от наблюдателя. Я спрятал собственную неопределённость от города. Алина жила после рассвета — Надя видела её. Дальше у нас только пропуск. Не называй этот пропуск смертью ради красивой развязки. Но и мою вину не стирай ради тишины.","I cut the signal. People already crowded the shelter entrance; if the square followed the children, the passage would collapse. I chose those I could see. Then I removed Alina: she returned to the sluice, and I did not know whether to count her as safe. Mara hid the children from the observer. I hid my uncertainty from the town. Nadia saw Alina after dawn. Beyond that is a gap. Do not call it death for a neat ending. Do not erase my guilt for peace, either."],
 "sonya":["Соня","Sonya","Я всё ещё слышу, как она сказала: «Не держитесь за меня. Держитесь друг за друга». Я была тем ребёнком на фотографии. Алина провела нас через служебную дверь. Она вернулась закрыть затвор, когда мы уже вышли. Я не знаю, куда она пошла потом. Это важно: я свидетель того, что видела, а не того, что тебе хочется узнать. Если расскажешь городу, можешь не называть меня? Наблюдатель следует за именами. А иногда — за тем, кто слишком громко идёт обратно.","I still hear her: ‘Do not hold on to me. Hold on to each other.’ I was the child in the photograph. Alina led us through the service door, then returned to close the sluice. I do not know where she went next. I can testify to what I saw, not to what you need to know. If you tell the town, will you leave out my name? The observer follows names. Sometimes it follows whoever walks back too loudly."],
 "caught":["Отголосок","Echo","Холод касается виска. На мгновение ты забываешь, зачем шла сюда. Но записи остаются у тебя в руках. Ты оказываешься у начала тропы; свидетельства не потеряны. Не беги вслепую: каменное укрытие гасит след, а повороты прерывают видимость. Наблюдатель не знает, где ты, пока не увидит или не услышит.","Cold touches your temple. For a moment you forget why you came. Your notes remain. You return to the beginning of the trail without losing evidence. Use the stone shelter and break line of sight. The observer must see or hear you to know where you are."],
 "public":["Конец эпизода · Имена остаются","Episode ending · Names remain","Ты оставляешь обе версии списка на площади. Павел произносит вслух то, что подписал. Лев впервые читает имена, а не число. Надя приносит свои записи: Алина была жива после рассвета. Город не становится безмятежным. Несколько дверей так и остаются не на своих местах. Но теперь жители могут спорить об одном событии, а не поодиночке сомневаться в собственном существовании. Мара находит на последней странице адрес старого особняка. История Алины продолжается там. Эпизод I завершён.","You leave both lists in the square. Pavel reads his order aloud. Lev reads names instead of a number. Nadia brings her notes: Alina was alive after dawn. The town is not suddenly peaceful. Some doors remain misplaced. But its people can argue about a shared event rather than doubt themselves alone. On the last page, Mara finds the old manor's address. Alina's story continues there. Episode I complete."],
 "sealed":["Конец эпизода · Тихая вода","Episode ending · Still water","Ты возвращаешь список в запертый каталог. Утром площадь спокойна. Павел говорит, что буря прошла; Надя не спорит. Соня может снова выйти из укрытия, но никто не узнает, почему она столько лет не приходила домой. Ты сохранила людям сегодняшний покой и оставила им вчерашнюю пустоту. На своём экземпляре фотографии ты записываешь: «Алина была жива после рассвета». Эту строку город больше не заберёт. За ней — адрес старого особняка. Эпизод I завершён.","You lock the list in the catalogue again. Morning is quiet. Pavel says the storm passed; Nadia does not argue. Sonya may leave her shelter, but nobody will know why she stayed away. You preserved today's peace and yesterday's absence. On your copy of the photograph, you write: ‘Alina was alive after dawn.’ The town cannot take that line away. Below it lies the old manor's address. Episode I complete."]
}
static func pair(value: Array, language: String) -> String:
	return str(value[1] if language=="en" else value[0])
